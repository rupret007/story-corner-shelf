{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:r11:gate-a-left:ephemeral-permit:v1",
  "title": "R11 Gate A-left external single-use permit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "permit_id",
    "attempt_id",
    "permission_id",
    "attempt_evidence_sha256",
    "permission_evidence_sha256",
    "unique_marker_sha256",
    "reviewed_job_digest",
    "sliced_plate_file_sha256",
    "gcode_payload_sha256",
    "gcode_payload_bytes",
    "gcode_config_block_sha256",
    "profile_closure_sha256",
    "job_identity_sha256",
    "ledger_identity_sha256",
    "static_package_manifest_sha256",
    "issued_at_utc",
    "expires_at_utc",
    "ledger_nonce",
    "permit_state_at_issue",
    "effective_print_authorized_at_issue",
    "hard_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "r11.gate-a-left-ephemeral-permit.v1"
    },
    "permit_id": {
      "type": "string",
      "pattern": "^r11-permit-[A-Za-z0-9][A-Za-z0-9._-]{7,95}$"
    },
    "attempt_id": {
      "type": "string"
    },
    "permission_id": {
      "type": "string"
    },
    "attempt_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "permission_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "unique_marker_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "attempt_evidence_sha256",
        "sliced_plate_file_sha256",
        "reviewed_job_digest",
        "gcode_payload_sha256",
        "job_identity_sha256",
        "permission_id"
      ],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/sha256"},
        "attempt_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "sliced_plate_file_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed_job_digest": {"$ref": "#/$defs/sha256"},
        "gcode_payload_sha256": {"$ref": "#/$defs/sha256"},
        "job_identity_sha256": {"$ref": "#/$defs/sha256"},
        "permission_id": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewed_job_digest": {
      "$ref": "#/$defs/sha256"
    },
    "sliced_plate_file_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "gcode_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "gcode_payload_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "gcode_config_block_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "profile_closure_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "job_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "ledger_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "static_package_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "issued_at_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "expires_at_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "ledger_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "permit_state_at_issue": {
      "const": "issued_unconsumed"
    },
    "effective_print_authorized_at_issue": {
      "const": true
    },
    "hard_boundary": {
      "$ref": "#/$defs/hardBoundary"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "hardBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drilling_coordinates_released",
        "drilling_schedule_released",
        "wall_installation_authorized",
        "test_load_authorized",
        "stored_load_authorized",
        "production_printing_authorized",
        "full_wall_printing_authorized",
        "rated_load_kg",
        "rated_load_lb"
      ],
      "properties": {
        "drilling_coordinates_released": {
          "const": false
        },
        "drilling_schedule_released": {
          "const": false
        },
        "wall_installation_authorized": {
          "const": false
        },
        "test_load_authorized": {
          "const": false
        },
        "stored_load_authorized": {
          "const": false
        },
        "production_printing_authorized": {
          "const": false
        },
        "full_wall_printing_authorized": {
          "const": false
        },
        "rated_load_kg": {
          "const": 0.0
        },
        "rated_load_lb": {
          "const": 0.0
        }
      }
    }
  }
}
